{
  "name": "inside-the-llm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Watch a GPT-2 class language model think, step by step, entirely in your browser.",
  "license": "MIT",
  "author": "Grzegorz Jaworski (https://gj-dev.com)",
  "homepage": "https://jaworskig00.github.io/inside-the-llm/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaworskig00/inside-the-llm.git"
  },
  "bugs": {
    "url": "https://github.com/jaworskig00/inside-the-llm/issues"
  },
  "keywords": [
    "llm",
    "transformer",
    "gpt-2",
    "onnxruntime-web",
    "webgpu",
    "d3",
    "data-visualization",
    "attention",
    "logit-lens",
    "react"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/copy_ort.mjs && vite",
    "build": "node scripts/copy_ort.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json,yml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "shots": "node scripts/capture_media.mjs",
    "record:fixture": "node scripts/record_fixture.mjs"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "d3": "7.9.0",
    "d3-sankey": "0.12.3",
    "onnxruntime-web": "1.31.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@types/d3": "7.4.3",
    "@types/d3-sankey": "0.12.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "onnxruntime-node": "1.31.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
