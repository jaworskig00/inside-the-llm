{
  "name": "inside-the-llm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Watch a GPT-2 class language model think, step by step, entirely in your browser.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/copy_ort.mjs && vite",
    "build": "node scripts/copy_ort.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json,yml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "shots": "node scripts/capture_media.mjs",
    "record:fixture": "node scripts/record_fixture.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "d3": "7.9.0",
    "d3-sankey": "0.12.3",
    "onnxruntime-web": "1.31.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@types/d3": "7.4.3",
    "@types/d3-sankey": "0.12.4",
    "@types/node": "22.19.1",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.0",
    "eslint-plugin-react-refresh": "0.5.0",
    "globals": "16.5.0",
    "onnxruntime-node": "1.31.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
